{
  "manifest_version": 3,
  "name": "Reply Buddy for X",
  "version": "2.2.0",
  "description": "Suggests short, human replies in your own voice on x.com. You pick one and post it yourself.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://pbs.twimg.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Reply Buddy settings" }
}
